
#!/usr/bin/env python3
import json
import os
import socket

from kafka import KafkaConsumer

BOOTSTRAP_SERVERS = "127.0.0.1:9092"
TOPIC = "demo-topic"
CONSUMER_GROUP = "demo-group"

consumer_name = os.environ.get(
    "CONSUMER_NAME",
    socket.gethostname()
)

consumer = KafkaConsumer(
    TOPIC,
    bootstrap_servers=BOOTSTRAP_SERVERS,
    group_id=CONSUMER_GROUP,
    client_id=consumer_name,
    auto_offset_reset="earliest",
    enable_auto_commit=True,
    value_deserializer=lambda value: json.loads(value.decode("utf-8")),
)

print(f"[{consumer_name}] Started")
print(f"[{consumer_name}] Topic: {TOPIC}")
print(f"[{consumer_name}] Consumer group: {CONSUMER_GROUP}")

try:
    for record in consumer:
        print(
            f"[{consumer_name}] "
            f"partition={record.partition} "
            f"offset={record.offset} "
            f"key={record.key.decode('utf-8') if record.key else None} "
            f"message={record.value}",
            flush=True,
        )
except KeyboardInterrupt:
    print(f"[{consumer_name}] Stopping")
finally:
    consumer.close()
